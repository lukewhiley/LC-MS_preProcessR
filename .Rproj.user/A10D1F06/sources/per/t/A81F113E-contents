rsd <- function(x) {
  if (!is.numeric(x)) stop("Input must be numeric")
  mean_x <- mean(x, na.rm = TRUE)
  sd_x <- sd(x, na.rm = TRUE)
  rsd <- (sd_x / mean_x) * 100
  return(round(rsd, 1))
