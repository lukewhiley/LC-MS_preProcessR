# Bar plot for single time point group comparisons
plot_group_bar <- function(lipid_name, day_val, pval_anova) {
  
  df <- univariateData %>%
    filter(sampleDay == day_val) %>%
    select(sampleGroup, value = all_of(lipid_name))
  
  df_summary <- df %>%
    group_by(sampleGroup) %>%
    summarise(mean = mean(value, na.rm = TRUE), sd = sd(value, na.rm = TRUE), .groups = "drop")
  
  ggplot(df_summary, aes(x = sampleGroup, y = mean, fill = sampleGroup)) +
    geom_col(width = 0.6, colour = "black", linewidth = 0.3) +
    geom_errorbar(aes(ymin = mean - sd, ymax = mean + sd), width = 0.2) +
    geom_jitter(data = df, aes(x = sampleGroup, y = value), 
                width = 0.1, size = 2, shape = 21, fill = "white", alpha = 0.7) +
    scale_fill_manual(values = c("control" = "grey80", "VDRC_101700" = "lightblue", "VDRC_100472" = "darkblue")) +
    labs(
      title = lipid_name,
      subtitle = paste0("Day ", day_val, " | ANOVA p.adj = ", signif(pval_anova, 3)),
      x = NULL, y = "Concentration"
    ) +
    theme_bw(base_size = 10) +
    theme(legend.position = "none", axis.text.x = element_text(angle = 30, hjust = 1))
}

# Line plot for time effect within a group
plot_time_line <- function(lipid_name, grp, pval_time) {
  
  df <- univariateData %>%
    filter(sampleGroup == grp) %>%
    select(sampleDay, value = all_of(lipid_name)) %>%
    mutate(sampleDay = as.numeric(as.character(sampleDay)))
  
  df_summary <- df %>%
    group_by(sampleDay) %>%
    summarise(mean = mean(value, na.rm = TRUE), sd = sd(value, na.rm = TRUE), .groups = "drop")
  
  ggplot(df_summary, aes(x = sampleDay, y = mean)) +
    geom_line(linewidth = 0.8, colour = "grey30") +
    geom_point(size = 3, shape = 21, fill = "steelblue", stroke = 0.8) +
    geom_errorbar(aes(ymin = mean - sd, ymax = mean + sd), width = 0.3) +
    geom_jitter(data = df, aes(y = value), width = 0.15, size = 1.5, alpha = 0.5) +
    scale_x_continuous(breaks = c(5, 10)) +
    labs(
      title = paste0(lipid_name, " — ", grp),
      subtitle = paste0("Time p.adj = ", signif(pval_time, 3)),
      x = "Day", y = "Concentration"
    ) +
    theme_bw(base_size = 10)
}

# Interaction line plot (same as before)
plot_interaction <- function(lipid_name, pval_interaction) {
  
  df <- univariateData %>%
    select(sampleGroup, sampleDay, value = all_of(lipid_name))
  
  df_summary <- df %>%
    group_by(sampleGroup, sampleDay) %>%
    summarise(mean = mean(value, na.rm = TRUE), sd = sd(value, na.rm = TRUE), .groups = "drop") %>%
    mutate(sampleDay = as.numeric(as.character(sampleDay)))
  
  ggplot(df_summary, aes(x = sampleDay, y = mean, colour = sampleGroup, fill = sampleGroup)) +
    geom_line(linewidth = 0.8) +
    geom_point(size = 3, shape = 21, stroke = 0.8) +
    geom_errorbar(aes(ymin = mean - sd, ymax = mean + sd), width = 0.3, linewidth = 0.5) +
    geom_jitter(data = df %>% mutate(sampleDay = as.numeric(as.character(sampleDay))),
                aes(y = value), shape = 21, size = 1.5, width = 0.15, alpha = 0.5) +
    scale_colour_manual(values = c("control" = "grey40", "VDRC_101700" = "steelblue", "VDRC_100472" = "navy")) +
    scale_fill_manual(values = c("control" = "grey80", "VDRC_101700" = "lightblue", "VDRC_100472" = "darkblue")) +
    scale_x_continuous(breaks = c(5, 10)) +
    labs(title = lipid_name,
         subtitle = paste0("Interaction p.adj = ", signif(pval_interaction, 3)),
         x = "Day", y = "Concentration", colour = "Group", fill = "Group") +
    theme_bw(base_size = 10) +
    theme(legend.position = "bottom")
}

