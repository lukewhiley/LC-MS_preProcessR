library(tidyverse)
library(broom)
library(patchwork)

# ============================================================
# 1. Setup
# ============================================================

univariateData <- univariateData %>%
  mutate(
    sampleGroup = factor(sampleGroup, levels = c("control", "VDRC_101700", "VDRC_100472")),
    sampleDay = factor(sampleDay, levels = c("5", "10"))
  )

metaCols <- c("sampleGroup", "sampleDay")
lipidCols <- names(univariateData %>% select(!contains("sample")))

# ============================================================
# 2. Group comparisons at each time point separately
# ============================================================

timepoint_results <- map_dfr(c("5", "10"), function(day) {
  
  dayData <- univariateData %>% filter(sampleDay == day)
  
  map_dfr(lipidCols, function(lipid) {
    
    df <- dayData %>% select(sampleGroup, value = all_of(lipid))
    
    # one-way ANOVA: control vs VDRC_101700 vs VDRC_100472
    anova_p <- tryCatch({
      summary(aov(value ~ sampleGroup, data = df))[[1]]$`Pr(>F)`[1]
    }, error = function(e) NA)
    
    # pairwise: control vs each VDRC line
    ctrl_vs_101700 <- tryCatch({
      t.test(
        df %>% filter(sampleGroup == "control") %>% pull(value),
        df %>% filter(sampleGroup == "VDRC_101700") %>% pull(value)
      )$p.value
    }, error = function(e) NA)
    
    ctrl_vs_100472 <- tryCatch({
      t.test(
        df %>% filter(sampleGroup == "control") %>% pull(value),
        df %>% filter(sampleGroup == "VDRC_100472") %>% pull(value)
      )$p.value
    }, error = function(e) NA)
    
    tibble(
      lipid = lipid,
      day = day,
      p_anova = anova_p,
      p_ctrl_vs_101700 = ctrl_vs_101700,
      p_ctrl_vs_100472 = ctrl_vs_100472
    )
  })
})

# FDR correction within each day
timepoint_results <- timepoint_results %>%
  group_by(day) %>%
  mutate(
    pAdj_anova = p.adjust(p_anova, method = "BH"),
    pAdj_ctrl_vs_101700 = p.adjust(p_ctrl_vs_101700, method = "BH"),
    pAdj_ctrl_vs_100472 = p.adjust(p_ctrl_vs_100472, method = "BH")
  ) %>%
  ungroup()

# split by day for easy access
results_d5 <- timepoint_results %>% filter(day == "5") %>% arrange(pAdj_anova)
results_d10 <- timepoint_results %>% filter(day == "10") %>% arrange(pAdj_anova)

cat("--- Day 5 group differences (FDR < 0.05) ---\n")
cat("ANOVA:             ", sum(results_d5$pAdj_anova < 0.05, na.rm = TRUE), "\n")
cat("Ctrl vs 101700:    ", sum(results_d5$pAdj_ctrl_vs_101700 < 0.05, na.rm = TRUE), "\n")
cat("Ctrl vs 100472:    ", sum(results_d5$pAdj_ctrl_vs_100472 < 0.05, na.rm = TRUE), "\n")

cat("\n--- Day 10 group differences (FDR < 0.05) ---\n")
cat("ANOVA:             ", sum(results_d10$pAdj_anova < 0.05, na.rm = TRUE), "\n")
cat("Ctrl vs 101700:    ", sum(results_d10$pAdj_ctrl_vs_101700 < 0.05, na.rm = TRUE), "\n")
cat("Ctrl vs 100472:    ", sum(results_d10$pAdj_ctrl_vs_100472 < 0.05, na.rm = TRUE), "\n")

# ============================================================
# 3. Time effect within each group
# ============================================================

time_results <- map_dfr(c("control", "VDRC_101700", "VDRC_100472"), function(grp) {
  
  grpData <- univariateData %>% filter(sampleGroup == grp)
  
  map_dfr(lipidCols, function(lipid) {
    
    df <- grpData %>% select(sampleDay, value = all_of(lipid))
    
    time_p <- tryCatch({
      t.test(value ~ sampleDay, data = df)$p.value
    }, error = function(e) NA)
    
    # fold change: day10 / day5
    mean_d5 <- mean(df %>% filter(sampleDay == "5") %>% pull(value), na.rm = TRUE)
    mean_d10 <- mean(df %>% filter(sampleDay == "10") %>% pull(value), na.rm = TRUE)
    
    tibble(
      lipid = lipid,
      group = grp,
      p_time = time_p,
      mean_d5 = mean_d5,
      mean_d10 = mean_d10,
      fc_d10_vs_d5 = mean_d10 / mean_d5,
      log2fc = log2(mean_d10 / mean_d5)
    )
  })
})

time_results <- time_results %>%
  group_by(group) %>%
  mutate(pAdj_time = p.adjust(p_time, method = "BH")) %>%
  ungroup()

cat("\n--- Time effects (FDR < 0.05) ---\n")
for(grp in c("control", "VDRC_101700", "VDRC_100472")) {
  n_sig <- sum(time_results %>% filter(group == grp) %>% pull(pAdj_time) < 0.05, na.rm = TRUE)
  cat(grp, ": ", n_sig, "\n")
}

